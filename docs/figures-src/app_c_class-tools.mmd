    direction TB
    class ICanvasTool {
        <<interface>>
        +onMouseDown() ToolResult
        +onMouseMove() ToolResult
        +onMouseUp() ToolResult
        +onClick() ToolResult
        +onKeyDown() ToolResult
        +overlay() ToolOverlay
        +cancel() ToolResult
    }
    class CreationTool~T~ {
        #draft : T
        #beginDraft()
        #commitDraft() ToolResult
        #cancelDraft() ToolResult
    }
    class ShapeCreationTool~T~
    class DragTool~T~
    class ToolResult {
        +handled : bool
        +needsRedraw : bool
        +action : ToolAction
    }

