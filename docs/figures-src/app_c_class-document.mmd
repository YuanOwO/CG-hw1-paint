classDiagram
    direction TB
    class Document {
        +addObject(object)
        +removeObject(object)
        +undo()
        +redo()
        +isModified() bool
    }
    class CommandHistory {
        +execute(command)
        +undo()
        +redo()
        +markSaved()
    }
    class IUndoableCommand {
        <<interface>>
        +execute()
        +undo()
    }
    class Scene {
        +add(object)
        +insert(index, object)
        +remove(object)
        +clear()
    }
    class SceneObject {
        <<abstract>>
    }
    class ShapeObject {
        <<abstract>>
        +getVertices()
        +isClosed() bool
    }

    Document *-- Scene
    Document *-- CommandHistory
    CommandHistory o-- IUndoableCommand : undo / redo 堆疊
    IUndoableCommand <|.. AddObjectCommand
    IUndoableCommand <|.. RemoveObjectCommand
    IUndoableCommand <|.. InsertObjectCommand
    IUndoableCommand <|.. ClearSceneCommand
    AddObjectCommand ..> Scene : 修改
    Scene o-- SceneObject
    SceneObject <|-- ShapeObject
    SceneObject <|-- TextObject
    ShapeObject <|-- PointShape
    ShapeObject <|-- TwoPointShape
    ShapeObject <|-- PathShape
    ShapeObject <|-- PolygonShape
    TwoPointShape <|-- LineShape
    TwoPointShape <|-- RectangleShape
    TwoPointShape <|-- EllipseShape
